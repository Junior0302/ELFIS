# Frontend — Firebase (projet ELFIS Core)
# Console Firebase → Paramètres du projet → Vos applications → Web
# Clé Web réelle (préfixe AIza). Interdit : TA_CLE_FIREBASE / placeholders.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Format 1:<project-number>:web:<id>. Interdit : TON_APP_ID_FIREBASE
VITE_FIREBASE_APP_ID=

# Dev : laisser VITE_API_URL vide → "/api" via le proxy Vite
# Build production : obligatoire, HTTPS, suffixe /api (pas /api/api)
# VITE_API_URL=https://elfis-core-api-4lul.onrender.com/api
