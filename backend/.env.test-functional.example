# ELFIS Core — environnement de recette fonctionnelle
# Copier vers .env.test-functional (ne jamais committer de secrets réels)

ELFIS_ENVIRONMENT=test
APP_ENV=test
AUTH_REQUIRED=true

# Base dédiée (SQLite simple) — ou PostgreSQL local : postgresql+psycopg://elfis:elfis@localhost:5432/elfis_functional_recette
DATABASE_URL=sqlite:///./elfis_functional_recette.db
JWT_SECRET=elfis-functional-recette-jwt-secret-not-for-prod-32c
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://127.0.0.1:8000

PLATFORM_ADMIN_EMAILS=platform.admin@test.elfis.local

# Aucun appel réseau réel par défaut
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_recette_test_only_not_real
STRIPE_PRICE_PRO=price_recette_starter_test
STRIPE_PRICE_STARTER_MONTHLY=price_recette_starter_test
BREVO_API_KEY=
SMTP_HOST=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Billing — enforcement configurable pour scénarios quota
ELFIS_BILLING_ENABLED=true
ELFIS_BILLING_ENFORCE_ENTITLEMENTS=false
ELFIS_BILLING_ENFORCE_QUOTAS=false
ELFIS_DEFAULT_PLAN_CODE=starter
ELFIS_TRIAL_DAYS=14

# OCR / AI / workers
ELFIS_OCR_ENABLED=false
ELFIS_OCR_PROVIDER=disabled
ELFIS_AI_ENABLED=true
ELFIS_JOB_WORKER_ENABLED=false
ELFIS_EVENT_WORKER_ENABLED=false

# Sécurité / observabilité / reliability
ELFIS_SECURITY_HEADERS_ENABLED=true
ELFIS_CSP_ENABLED=true
ELFIS_CSP_REPORT_ONLY=true
ELFIS_HSTS_ENABLED=false
ELFIS_RATE_LIMIT_ENABLED=true
ELFIS_RATE_LIMIT_AUTH_PER_MINUTE=60
ELFIS_RATE_LIMIT_DEFAULT_PER_MINUTE=300
ELFIS_LOG_LEVEL=INFO
ELFIS_LOG_FORMAT=text
ELFIS_LOG_INCLUDE_REQUEST_BODY=false
ELFIS_METRICS_ENABLED=true
ELFIS_METRICS_REQUIRE_AUTH=true
ELFIS_CLEANUP_ENABLED=false
ELFIS_CLEANUP_DRY_RUN=true

# Mot de passe des comptes seed (documenté — API utilise JWT)
# TEST_PASSWORD=ElfisRecette!Test-2026
