# ELFIS Core — exemple investor-demo
# Aucune valeur réelle. Copier les secrets uniquement dans le dashboard Render / Firebase.

ELFIS_ENVIRONMENT=production
APP_ENV=production
AUTH_REQUIRED=true

# PostgreSQL managé — fourni par Render (fromDatabase) ou collé à la main.
# Jamais sqlite. Jamais de mot de passe ici.
DATABASE_URL=

JWT_SECRET=
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
CORS_ORIGINS=https://elfis-core.web.app,https://elfis-core.firebaseapp.com
FRONTEND_URL=https://elfis-core.web.app
PUBLIC_API_URL=
PLATFORM_ADMIN_EMAILS=

STORAGE_PROVIDER=local
STORAGE_DIR=/data/storage

ELFIS_BILLING_ENABLED=false
ELFIS_AI_ENABLED=false
ELFIS_OCR_ENABLED=false
ELFIS_OCR_PROVIDER=disabled
ELFIS_EVENT_WORKER_ENABLED=false
ELFIS_JOB_WORKER_ENABLED=false
ELFIS_DEV_TRIAL_ENABLED=false
ELFIS_DEMO_BANK_ENABLED=true

# Laisser vides : pas de faux succès
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
OPENAI_API_KEY=
BREVO_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
PLATFORM_EMAIL_FROM=
BANKING_BRIDGE_CLIENT_ID=
BANKING_BRIDGE_CLIENT_SECRET=
BANKING_BRIDGE_REDIRECT_URI=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
