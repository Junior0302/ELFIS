# Environnements : development | test | staging | production
# Preferer ELFIS_ENVIRONMENT ; APP_ENV reste un alias de compatibilite.
ELFIS_ENVIRONMENT=development
APP_ENV=development

# --- Secrets : laisser vides ici ; jamais de valeurs reelles dans le depot ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# development/test : SQLite OK. staging/production : PostgreSQL obligatoire.
DATABASE_URL=sqlite:///./comptapilot.db
STORAGE_DIR=./storage

# production : liste explicite HTTPS (jamais * avec credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# production : >= 32 caracteres, jamais la valeur par defaut applicative
JWT_SECRET=change-me-in-production
AUTH_REQUIRED=true

# Même clé Web API que VITE_FIREBASE_API_KEY (Firebase Console → Paramètres projet)
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=

# Stripe Billing — ComptaPilot Pro 19 €/mois, essai de 14 jours
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
# Alias Billing V1 (starter = offre actuelle ; laissez vide pour réutiliser STRIPE_PRICE_PRO)
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_TRIAL_DAYS=14
STRIPE_PAST_DUE_GRACE_DAYS=7
SUBSCRIPTION_TERMS_VERSION=v1
# Token pour POST /api/subscriptions/jobs/trial-reminders (cron Render/externe)
SUBSCRIPTION_CRON_TOKEN=

# ELFIS Billing — Subscriptions / Entitlements / Quotas V1
ELFIS_BILLING_ENABLED=true
ELFIS_BILLING_PROVIDER=stripe
ELFIS_DEFAULT_PLAN_CODE=starter
ELFIS_TRIAL_DAYS=14
# C1.2 — Endpoint local POST /api/dev/activate-trial (+ GET /api/dev/trial-status)
# Uniquement si ELFIS_ENVIRONMENT/APP_ENV ∈ {development, test}.
# Désactivé par défaut. Ne jamais activer en production / staging / preview.
# Local : créer backend/.env (non versionné) avec ELFIS_DEV_TRIAL_ENABLED=true
# puis redémarrer FastAPI.
ELFIS_DEV_TRIAL_ENABLED=false
ELFIS_BILLING_PAST_DUE_GRACE_DAYS=7
ELFIS_BILLING_SYNC_GRACE_SECONDS=3600
ELFIS_BILLING_WEBHOOK_MAX_BYTES=1048576
ELFIS_BILLING_USAGE_WARNING_PERCENT=80
ELFIS_BILLING_USAGE_CRITICAL_PERCENT=100
ELFIS_BILLING_ENFORCE_ENTITLEMENTS=false
ELFIS_BILLING_ENFORCE_QUOTAS=false
FRONTEND_URL=http://localhost:5173
# Prod : https://elfis-core.com (Stripe success/cancel + liens d'invitation)
# URL publique HTTPS de l’API (Render) — pour avatars / liens absolus
PUBLIC_API_URL=https://elfis-core-api.onrender.com

# Adresses séparées par des virgules (super-admin ELFIS) — placeholder fictif
PLATFORM_ADMIN_EMAILS=platform.admin@example.com

# E-mail transactionnel plateforme (ELFIS Core) — jamais une clé dans le frontend
# Mode A (prioritaire) : SMTP Brevo → smtp-relay.brevo.com
#   SMTP_USER = login …@smtp-brevo.com
#   SMTP_PASSWORD = clé SMTP xsmtpsib-… (PAS xkeysib-)
# Mode B (secours) : API Brevo HTTPS
#   BREVO_API_KEY = clé API xkeysib-… (PAS xsmtpsib-)
# IMPORTANT : ne dupliquez PAS SMTP_* plus bas (python-dotenv : dernière clé gagne → écrase le host).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=
PLATFORM_EMAIL_FROM=documents@elfiscore.com
PLATFORM_EMAIL_FROM_NAME=ComptaPilot
# Alias rétrocompatible (utilisé si PLATFORM_EMAIL_FROM vide)
SMTP_FROM=

# Chiffrement des jetons OAuth / mots de passe SMTP org (Fernet url-safe 32 bytes)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_CREDENTIALS_ENCRYPTION_KEY=

# Google OAuth (Gmail send)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/email-connections/oauth/google/callback

# Microsoft OAuth (Graph Mail.Send)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/api/email-connections/oauth/microsoft/callback

# ELFIS Vault — PDF privés via Supabase Storage (jamais exposer la service role au frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ELFIS_VAULT_BUCKET=elfis-vault
ELFIS_VAULT_MAX_FILE_SIZE_MB=15
ELFIS_VAULT_SIGNED_URL_TTL_SECONDS=300

# ELFIS Event Bus V1 (worker séparé en prod)
ELFIS_EVENT_WORKER_ENABLED=false
ELFIS_EVENT_WORKER_BATCH_SIZE=20
ELFIS_EVENT_WORKER_POLL_INTERVAL_SECONDS=2
ELFIS_EVENT_MAX_ATTEMPTS=5
ELFIS_EVENT_RETRY_BASE_SECONDS=10
ELFIS_EVENT_LOCK_TIMEOUT_SECONDS=300
ELFIS_EVENT_WORKER_ID=

# ELFIS Job Queue V1 (distinct de l'Event Bus — postgres recommandé)
ELFIS_JOB_WORKER_ENABLED=false
ELFIS_JOB_WORKER_QUEUES=default
ELFIS_JOB_WORKER_BATCH_SIZE=10
ELFIS_JOB_WORKER_POLL_INTERVAL_SECONDS=2
ELFIS_JOB_MAX_ATTEMPTS=5
ELFIS_JOB_RETRY_BASE_SECONDS=15
ELFIS_JOB_LOCK_TIMEOUT_SECONDS=300
ELFIS_JOB_HEARTBEAT_INTERVAL_SECONDS=30
ELFIS_JOB_DEFAULT_TIMEOUT_SECONDS=300
ELFIS_JOB_WORKER_ID=
ELFIS_JOB_MAX_PAYLOAD_BYTES=65536
ELFIS_JOB_MAX_RESULT_BYTES=65536
# Enqueue metadata_check après vault.document.archived.v1 (ne bloque pas l'archivage)
ELFIS_VAULT_METADATA_JOB_ENABLED=true

# ELFIS AI Engine V1
ELFIS_AI_ENABLED=true
ELFIS_AI_PROVIDER=openai
# Vide = OPENAI_CHAT_MODEL
ELFIS_AI_DEFAULT_MODEL=
ELFIS_AI_FAST_MODEL=
ELFIS_AI_COMPLEX_MODEL=
ELFIS_AI_REQUEST_TIMEOUT_SECONDS=120
ELFIS_AI_MAX_RETRIES=2
ELFIS_AI_MAX_INPUT_BYTES=262144
ELFIS_AI_MAX_OUTPUT_BYTES=65536
# Quotas préparés (non bloquants en V1 hors ELFIS_AI_ENABLED)
ELFIS_AI_MAX_EXECUTIONS_PER_ORG_PER_DAY=1000
ELFIS_AI_MAX_CONCURRENT_JOBS_PER_ORG=10

# ELFIS Document Intelligence V1
ELFIS_DOCUMENT_INTELLIGENCE_ENABLED=true
ELFIS_AUTO_TEXT_EXTRACTION_ENABLED=true
ELFIS_AUTO_AI_ANALYSIS_ENABLED=true
ELFIS_DOCUMENT_MAX_FILE_BYTES=20971520
ELFIS_DOCUMENT_MAX_PAGES=200
ELFIS_DOCUMENT_MAX_EXTRACTED_TEXT_BYTES=1048576
ELFIS_DOCUMENT_MIN_TEXT_CHARACTERS=50
ELFIS_DOCUMENT_MIN_TEXT_PER_PAGE=20
# Rétention documentée — purge auto non implémentée en V1
ELFIS_DOCUMENT_TEXT_RETENTION_DAYS=365
ELFIS_OCR_ENABLED=false
ELFIS_OCR_PROVIDER=disabled
ELFIS_OCR_REQUEST_TIMEOUT_SECONDS=180
ELFIS_OCR_MAX_RETRIES=2

# ELFIS Accounting Pipeline V1
ELFIS_ACCOUNTING_PIPELINE_ENABLED=true
ELFIS_AUTO_ACCOUNTING_PROPOSAL_ENABLED=true
ELFIS_ACCOUNTING_AMOUNT_TOLERANCE=0.02
ELFIS_ACCOUNTING_BALANCE_TOLERANCE=0.01
ELFIS_ACCOUNTING_AUTO_READY_CONFIDENCE=0.90
ELFIS_ACCOUNTING_HIGH_AMOUNT_REVIEW_THRESHOLD=10000
ELFIS_ACCOUNTING_REQUIRE_REVIEW_ON_DEFAULT_ACCOUNT=true
ELFIS_DEFAULT_PURCHASE_ACCOUNT=607000
ELFIS_DEFAULT_SALES_ACCOUNT=707000
ELFIS_DEFAULT_SUPPLIER_ACCOUNT=401000
ELFIS_DEFAULT_CUSTOMER_ACCOUNT=411000
ELFIS_DEFAULT_DEDUCTIBLE_VAT_ACCOUNT=445660
ELFIS_DEFAULT_COLLECTED_VAT_ACCOUNT=445710
ELFIS_DEFAULT_PURCHASE_JOURNAL=ACH
ELFIS_DEFAULT_SALES_JOURNAL=VTE

# ELFIS Search Engine V1
ELFIS_SEARCH_ENABLED=true
ELFIS_AUTO_SEARCH_INDEXING_ENABLED=true
ELFIS_SEARCH_LANGUAGE=french
ELFIS_SEARCH_MAX_QUERY_LENGTH=200
ELFIS_SEARCH_MAX_PAGE_SIZE=100
ELFIS_SEARCH_DEFAULT_PAGE_SIZE=20
ELFIS_SEARCH_MAX_CONTENT_BYTES=65536
ELFIS_SEARCH_SUGGESTION_LIMIT=10
ELFIS_SEARCH_SNIPPET_LENGTH=240
ELFIS_SEARCH_REINDEX_BATCH_SIZE=100

# ELFIS System Health Center (RC2.1+)
# Modes: real | mock | disabled — défaut mock (sûr pour CI/tests)
APP_VERSION=0.8.9
SYSTEM_HEALTH_USE_REAL_PROVIDERS=false
SYSTEM_HEALTH_API_PROVIDER=mock
SYSTEM_HEALTH_POSTGRES_PROVIDER=mock
SYSTEM_HEALTH_JOBS_PROVIDER=mock
SYSTEM_HEALTH_EVENTS_PROVIDER=mock
SYSTEM_HEALTH_SEARCH_PROVIDER=mock
SYSTEM_HEALTH_CACHE_TTL_SECONDS=15
SYSTEM_HEALTH_PROVIDER_TIMEOUT_SECONDS=5
# Seuils (documentés dans app/system_health/health_thresholds.py)
SYSTEM_HEALTH_POSTGRES_LATENCY_DEGRADED_MS=100
SYSTEM_HEALTH_POSTGRES_LATENCY_UNHEALTHY_MS=500
SYSTEM_HEALTH_POSTGRES_POOL_USAGE_DEGRADED=0.8
SYSTEM_HEALTH_JOBS_PENDING_DEGRADED=50
SYSTEM_HEALTH_JOBS_FAILED_DEGRADED=1
SYSTEM_HEALTH_JOBS_OLDEST_PENDING_DEGRADED_SECONDS=300
SYSTEM_HEALTH_JOBS_STALLED_UNHEALTHY=1
SYSTEM_HEALTH_EVENTS_PENDING_DEGRADED=50
SYSTEM_HEALTH_EVENTS_FAILED_DEGRADED=1
SYSTEM_HEALTH_EVENTS_OLDEST_PENDING_DEGRADED_SECONDS=300
SYSTEM_HEALTH_EVENTS_STALLED_UNHEALTHY=1

# ELFIS Platform Admin & Operations V1
ELFIS_PLATFORM_ADMIN_ENABLED=true
ELFIS_PLATFORM_INCIDENTS_ENABLED=true
ELFIS_PLATFORM_ADMIN_DEFAULT_PAGE_SIZE=25
ELFIS_PLATFORM_ADMIN_MAX_PAGE_SIZE=100
ELFIS_PLATFORM_ADMIN_SEARCH_LIMIT=20
ELFIS_PLATFORM_ADMIN_AUDIT_RETENTION_DAYS=730
ELFIS_PLATFORM_INCIDENT_DEDUP_WINDOW_SECONDS=3600
ELFIS_PLATFORM_ADMIN_REQUIRE_ACTION_REASON=true

# ELFIS Security / Observability / Reliability V1
ELFIS_ENVIRONMENT=development
ELFIS_SECURITY_HEADERS_ENABLED=true
ELFIS_CSP_ENABLED=true
ELFIS_CSP_REPORT_ONLY=true
ELFIS_HSTS_ENABLED=false
ELFIS_ALLOWED_ORIGINS=http://localhost:5173
ELFIS_ALLOW_CREDENTIALS=true
ELFIS_JWT_ISSUER=
ELFIS_JWT_AUDIENCE=
ELFIS_JWT_CLOCK_SKEW_SECONDS=30
# false = tokens historiques acceptés (transition) ; true = impose iss/aud
ELFIS_JWT_ENFORCE_ISSUER_AUDIENCE=false
ELFIS_RATE_LIMIT_ENABLED=true
ELFIS_RATE_LIMIT_BACKEND=memory
ELFIS_RATE_LIMIT_DEFAULT_PER_MINUTE=120
ELFIS_RATE_LIMIT_AUTH_PER_MINUTE=10
ELFIS_RATE_LIMIT_UPLOAD_PER_MINUTE=20
ELFIS_RATE_LIMIT_AI_PER_MINUTE=30
ELFIS_RATE_LIMIT_SEARCH_PER_MINUTE=120
ELFIS_RATE_LIMIT_EMAIL_PER_MINUTE=30
ELFIS_RATE_LIMIT_ADMIN_PER_MINUTE=120
ELFIS_RATE_LIMIT_WEBHOOK_PER_MINUTE=300
ELFIS_MAX_JSON_BODY_BYTES=1048576
ELFIS_MAX_EMAIL_BODY_BYTES=262144
ELFIS_MAX_ADMIN_REASON_LENGTH=1000
ELFIS_MAX_METADATA_JSON_BYTES=65536
ELFIS_LOG_LEVEL=INFO
ELFIS_LOG_FORMAT=json
ELFIS_LOG_INCLUDE_REQUEST_BODY=false
ELFIS_LOG_INCLUDE_RESPONSE_BODY=false
ELFIS_METRICS_ENABLED=true
ELFIS_METRICS_REQUIRE_AUTH=true
ELFIS_METRICS_TOKEN=
ELFIS_CLEANUP_ENABLED=false
ELFIS_CLEANUP_DRY_RUN=true
ELFIS_CLEANUP_BATCH_SIZE=500
ELFIS_STALE_JOB_SECONDS=1800
ELFIS_STALE_EVENT_SECONDS=1800
ELFIS_RETENTION_ADMIN_AUDIT_DAYS=730
ELFIS_RETENTION_BILLING_EVENTS_DAYS=730
ELFIS_RETENTION_JOB_ATTEMPTS_DAYS=180
ELFIS_RETENTION_EVENT_ATTEMPTS_DAYS=180
ELFIS_RETENTION_NOTIFICATIONS_DAYS=365
ELFIS_RETENTION_AI_USAGE_DAYS=730
ELFIS_RETENTION_DOCUMENT_EXTRACTIONS_DAYS=365
ELFIS_RETENTION_INCIDENTS_DAYS=730
ELFIS_RETENTION_DELIVERY_HISTORY_DAYS=365
ELFIS_RETENTION_SECURITY_EVENTS_DAYS=365

# --- RC1 / PostgreSQL de recette (jamais de mot de passe réel ici) ---
